{
  "name": "qiyun-rmc58-desktop",
  "productName": "QiYun-RMC58",
  "version": "0.9.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "QiYun-RMC58 web page packaged as a desktop app (Web Serial / Web USB)",
  "author": "QiYun-RMC58",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "sync-dist": "rm -rf dist && cp -R ../web/dist dist",
    "dist:mac": "npm run sync-dist && electron-builder --mac dmg --arm64",
    "dist:win": "npm run sync-dist && electron-builder --win zip --x64"
  },
  "build": {
    "appId": "org.qiyun.rmc58",
    "productName": "QiYun-RMC58",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "package.json",
      "dist/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "NSSupportsAutomaticTermination": false,
        "NSSupportsSuddenTermination": false,
        "NSAppSleepDisabled": true
      },
      "artifactName": "QiYun-RMC58-${version}-mac-arm64.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "QiYun-RMC58-${version}-win-x64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
