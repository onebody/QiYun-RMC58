# RF_TRACK 环境样例（systemd EnvironmentFile 格式：KEY=VALUE，# 是注释）。
# 复制到 /opt/rftrack/rftrack.env 并按现场改。全部 RFTRACK_* 键的语义见
# backend/app/config.py —— 那里是唯一收口，本文件只列部署最常动的那几行。

# --- 必看三行 ---------------------------------------------------------------
# 数据库：必须在 ReadWritePaths 覆盖的目录里（volume / 挂载点），删容器/换盘不丢数据。
RFTRACK_DB_PATH=/opt/rftrack/data/rftrack.sqlite3
# 实例角色：site（本场地读写）或 aggregator（只读汇聚，写侧一律 405）。
RFTRACK_INSTANCE_ROLE=site
# 监听：绑内网地址；汇聚实例要被多场地访问就绑 0.0.0.0 并自备反代/防火墙。
RFTRACK_BIND=0.0.0.0
RFTRACK_PORT=9000

# --- 常用调优（默认值见 config.py，S9 Pi 压测后再定最终值）--------------------
# RFTRACK_MAX_GATEWAYS=8
# RFTRACK_MAX_NODES_PER_GATEWAY=8
# RFTRACK_DIAL_CONCURRENCY=4
# RFTRACK_CAPTURE_FLUSH_INTERVAL_S=5
# RFTRACK_RETENTION_EVENTS_DAYS=7
# RFTRACK_RETENTION_SUMMARY_DAYS=30

# --- 可选 ------------------------------------------------------------------
# 回放源（演示/回归用；回放进来的数据一律 source=mock）：
# RFTRACK_REPLAY_DIR=/opt/rftrack/data/replay
# 强制锁场地（多场地库里指定本实例服务谁）：
# RFTRACK_SITE_ID=1
# 汇聚实例只提供 API 不挂页面：
# RFTRACK_WORKBENCH_DIR=
